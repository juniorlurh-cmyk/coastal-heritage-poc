# AI assistant + market briefing — free Groq key from https://console.groq.com
# Copy to .env.local for dev; use repo Secrets/Variables for the Pages build.
VITE_AI_API_KEY=
VITE_AI_MODEL=qwen/qwen3.8-27b
VITE_AI_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# Optional Umami analytics (cookie-free). Unset = zero trackers.
VITE_UMAMI_URL=
VITE_UMAMI_WEBSITE_ID=
